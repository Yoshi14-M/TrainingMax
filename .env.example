APP_NAME=TrainingMax
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP
APP_TIMEZONE=Asia/Tokyo

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password
DB_COLLATION=utf8mb4_0900_as_ci

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_EXPIRE_ON_CLOSE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SEED_GYM_NAME="TrainingMaxジム"
# SEED_OWNER_NAME="オーナー"
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD=password

SEED_DEV_USER_PASSWORD=password

# 「ログイン状態を保持する」の有効期間（分）
# AUTH_REMEMBER_DURATION=43200
# AUTH_PASSWORD_MIN=8
# AUTH_PASSWORD_MAX=72
# AUTH_PASSWORD_RESET_EXPIRE=60
# AUTH_INITIAL_PASSWORD_EXPIRE=4320
# RATE_LIMIT_LOGIN=5
# RATE_LIMIT_REGISTER=6
# RATE_LIMIT_PASSWORD_RESET=6
# RATE_LIMIT_INITIAL_PASSWORD_MAIL=1
# HSTS_MAX_AGE=31536000
# AUDIT_LOG_DAYS=90

# 招待コードの有効期限（日）
# INVITATION_CODE_EXPIRE_DAYS=7
# 招待コードの入力回数の制限（1ユーザーにつき）
# RATE_LIMIT_INVITATION_CODE_PER_MINUTE=5
# RATE_LIMIT_INVITATION_CODE_PER_HOUR=20

# 休憩タイマー（秒）
# TIMER_MIN_SECONDS=10
# TIMER_MAX_SECONDS=600
# TIMER_ADJUST_SECONDS=15
# TIMER_DEFAULT_SECONDS=90
# TIMER_BLINK_SECONDS=10